{
  "name": "@syncedco/motion",
  "version": "0.1.0",
  "description": "A semantic GSAP and Lenis motion toolkit designed to complement Synced Flow.",
  "type": "module",
  "sideEffects": [
    "./src/styles.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./lenis": {
      "types": "./dist/lenis.d.ts",
      "import": "./dist/lenis.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "vite example",
    "flow:build": "synced-flow build",
    "flow:check": "synced-flow build --check",
    "flow:lint": "synced-flow lint",
    "flow:doctor": "synced-flow doctor",
    "flow:watch": "synced-flow watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "units:check": "node scripts/check-units.mjs",
    "check": "npm run flow:check && npm run flow:lint && npm run units:check && npm run test && npm run build",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "animation",
    "gsap",
    "scrolltrigger",
    "lenis",
    "synced-flow",
    "motion",
    "scroll-animation"
  ],
  "license": "MIT",
  "peerDependencies": {
    "gsap": ">=3.13.0"
  },
  "dependencies": {
    "lenis": "^1.3.25"
  },
  "devDependencies": {
    "@syncedco/flow": "^0.3.2",
    "gsap": "^3.15.0",
    "jsdom": "^29.1.1",
    "tsup": "^8.5.1",
    "typescript": "5.7.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
